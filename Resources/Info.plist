<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- THE ENTIRE REASON THIS APP EXISTS. A PWA cannot declare this, which is
       why background audio dies a few seconds after the phone locks. -->
  <key>UIBackgroundModes</key>
  <array><string>audio</string></array>

  <!-- The site to load. A PLACEHOLDER on purpose: this repo is public and the
       real hostname is not. CI overwrites it from the MB_APP_URL secret. -->
  <key>MBAppURL</key>
  <string>https://example.invalid/</string>

  <!-- Hosts the webview may navigate to besides MBAppURL's own host.
       Cloudflare Access one-time-PIN login REDIRECTS OFF our origin and back;
       without this, first-launch login dead-ends and looks like a broken app. -->
  <key>MBAllowedHostSuffixes</key>
  <array><string>cloudflareaccess.com</string></array>

  <key>CFBundleDisplayName</key><string>Music Box</string>
  <key>UILaunchStoryboardName</key><string>LaunchScreen</string>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsArbitraryLoads</key><false/></dict>
</dict>
</plist>
